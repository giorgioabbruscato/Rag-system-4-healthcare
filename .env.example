# --- API ---
API_HOST="0.0.0.0"
API_PORT=8000
ALLOWED_ORIGINS='["http://localhost:8501"]'
DEBUG=false

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Embeddings ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# --- RAG ---
TOPK_CASES=5
TOPK_GUIDELINES=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
FRAMES_PER_CASE=3
MAX_QUERY_FRAMES=12
MAX_SIMILAR_FRAMES_TOTAL=12
KNN_MIN_SCORE_THRESHOLD=2.5
VECTOR_NAME="text_embedding"

# --- Qdrant ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_IN_MEMORY=true

# --- Paths ---
DATA_DIR="data"
RAW_DATA_DIR="data/raw_data"
DATASET_DIR="data/dataset_built"
GUIDELINES_DIR="data/guidelines_txt"

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=100
