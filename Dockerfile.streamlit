# Multi-stage build for Streamlit frontend
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Upgrade build toolchain (setuptools 82+ vendors jaraco.context 6.1.0; wheel CVE fix)
RUN pip install --no-cache-dir \
        pip==24.3.1 \
        setuptools==82.0.1 \
        'wheel>=0.46.2' \
    && pip install --no-cache-dir --no-warn-script-location --user -r requirements.txt \
    && pip install --no-cache-dir --no-warn-script-location --user \
        --upgrade setuptools==82.0.1 'wheel>=0.46.2'

# Final stage
FROM python:3.11-slim

WORKDIR /app

# Apply Debian security updates (libcap2, systemd/udev, etc.)
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Base image system site-packages are scanned by Trivy (separate from builder /root/.local)
RUN python -m pip install --no-cache-dir --upgrade \
        setuptools==82.0.1 \
        'wheel>=0.46.2'

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Ensure copied user site-packages also have patched toolchain (Trivy scans all dist-info)
RUN python -m pip install --no-cache-dir --user \
        --upgrade setuptools==82.0.1 'wheel>=0.46.2'

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app

# Copy application code
COPY app/ ./app/
COPY src/ ./src/

# Streamlit configuration
RUN mkdir -p /root/.streamlit \
    && printf '%s\n' \
        '[server]' \
        'headless = true' \
        'port = 8501' \
        'enableCORS = false' \
        'enableXsrfProtection = false' \
        > /root/.streamlit/config.toml

# Expose port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8501')" || exit 1

# Run Streamlit
CMD ["streamlit", "run", "app/streamlit_app.py"]
